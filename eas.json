{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_AUTH_SCHEME": "com.thermex.app",
        "EXPO_PUBLIC_DEV_LOGIN": "false"
      }
    },
    "uat": {
      "extends": "base",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://REPLACE-WITH-UAT-HOST/api/v1",
        "EXPO_PUBLIC_ENTRA_CLIENT_ID": "REPLACE-WITH-MOBILE-APP-REGISTRATION-CLIENT-ID",
        "EXPO_PUBLIC_ENTRA_TENANT_ID": "REPLACE-WITH-THERMAX-TENANT-ID"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://REPLACE-WITH-PROD-HOST/api/v1",
        "EXPO_PUBLIC_ENTRA_CLIENT_ID": "REPLACE-WITH-MOBILE-APP-REGISTRATION-CLIENT-ID",
        "EXPO_PUBLIC_ENTRA_TENANT_ID": "REPLACE-WITH-THERMAX-TENANT-ID"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
