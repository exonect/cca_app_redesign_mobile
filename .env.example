# Copy to .env for development. EXPO_PUBLIC_ values are bundled into the app.
EXPO_PUBLIC_API_BASE=https://mobility.thermaxglobal.com/cca_api/api/v1
# Microsoft Entra ID mobile app registration (from Thermax IT).
# Register the redirect URI com.thermex.app://auth (Android) and com.thermex.app://auth (iOS) as a public client.
EXPO_PUBLIC_ENTRA_CLIENT_ID=
EXPO_PUBLIC_ENTRA_TENANT_ID=
EXPO_PUBLIC_AUTH_SCHEME=com.thermex.app
# Test builds only: show "Sign in for testing" by email.
EXPO_PUBLIC_DEV_LOGIN=false
# Power BI report opened from More > Power BI (Admins), https only. Default: the report
# the old CCA mobile app showed. Empty: the app says Power BI is not set up.
EXPO_PUBLIC_POWERBI_URL=https://app.powerbi.com/view?r=eyJrIjoiMDQzMDk2NDQtMGQ5MC00NTYzLTg2YTktNDk0ODI3ZWU3YzY0IiwidCI6IjM2MjI5ZmVjLTYwN2UtNDRhMC04N2M4LWNkMWZlOWRmODJiYiIsImMiOjEwfQ%3D%3D
# Build numbers above the live store builds.
ANDROID_VERSION_CODE=8
IOS_BUILD_NUMBER=1
